# Copy to /etc/flow.env; chmod 600 /etc/flow.env
FLOW_HOST=127.0.0.1
FLOW_PORT=8090
FLOW_DATA_DIR=/www/wwwroot/flow/data
# Keep 1 for production HTTPS; use 0 only for local HTTP checks.
FLOW_COOKIE_SECURE=1
# Optional OpenAI-compatible chat completions endpoint; all values stay server-side.
FLOW_AI_URL=
FLOW_AI_MODEL=
FLOW_AI_KEY=
# Vertex AI / Agent Platform with ADC (instead of a static API key):
# FLOW_AI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# FLOW_AI_MODEL=google/your-available-model-id
# GOOGLE_APPLICATION_CREDENTIALS=/www/flow-secrets/adc.json

# Optional second service for text-only calls (for example DeepSeek). When all three are set, feedback,
# reading help and other text calls go here first; audio and web search stay on the main service above,
# and a text-service outage falls back to the main service automatically. Leave empty to keep one service.
# FLOW_TEXT_AI_URL=https://api.deepseek.com/chat/completions
# FLOW_TEXT_AI_MODEL=deepseek-chat
# FLOW_TEXT_AI_KEY=

# Optional site-wide daily ceiling (UTC day); 0 disables it.
FLOW_AI_DAILY_LIMIT=0
# Per-account daily ceiling (UTC day, admins exempt); 0 disables it.
FLOW_AI_USER_DAILY_LIMIT=0

# Optional verified email recovery. Use a dedicated SMTP account/app password.
FLOW_PUBLIC_URL=https://flowlang.cn
# FLOW_SMTP_HOST=smtp.example.com
# FLOW_SMTP_PORT=465
# FLOW_SMTP_FROM=Flow <noreply@example.com>
# FLOW_SMTP_USER=noreply@example.com
# FLOW_SMTP_PASSWORD=replace-with-app-password

# v0.6 gateway audio support; upgrade.sh detects /health before enabling.
FLOW_AI_AUDIO=0

# Operator API for xmc.hk/flow/ (loopback only; proxied by xmc.hk behind Cloudflare Access). 0 disables it.
FLOW_ADMIN_PORT=0
# Optional fixed secret for the survey rate-limit hash; otherwise a random file in FLOW_DATA_DIR is used.
# FLOW_SURVEY_SALT=
