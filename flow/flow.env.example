# Copy to /etc/flow.env; chmod 600 /etc/flow.env
FLOW_HOST=127.0.0.1
FLOW_PORT=8090
FLOW_DATA_DIR=/www/wwwroot/flow/data
# Keep 1 for production HTTPS; use 0 only for local HTTP checks.
FLOW_COOKIE_SECURE=1
# Optional OpenAI-compatible chat completions endpoint; all values stay server-side.
FLOW_AI_URL=
FLOW_AI_MODEL=
FLOW_AI_KEY=
# Vertex AI / Agent Platform with ADC (instead of a static API key):
# FLOW_AI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# FLOW_AI_MODEL=google/your-available-model-id
# GOOGLE_APPLICATION_CREDENTIALS=/www/flow-secrets/adc.json

# Optional site-wide daily ceiling (UTC day); 0 disables it. No personal daily call ceiling.
FLOW_AI_DAILY_LIMIT=0

# Optional verified email recovery. Use a dedicated SMTP account/app password.
FLOW_PUBLIC_URL=https://flowlang.cn
# FLOW_SMTP_HOST=smtp.example.com
# FLOW_SMTP_PORT=465
# FLOW_SMTP_FROM=Flow <noreply@example.com>
# FLOW_SMTP_USER=noreply@example.com
# FLOW_SMTP_PASSWORD=replace-with-app-password

# v0.6 gateway audio support; upgrade.sh detects /health before enabling.
FLOW_AI_AUDIO=0
