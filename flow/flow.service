[Unit]
Description=Flow English Learning Pilot
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/flow
EnvironmentFile=/etc/flow.env
ExecStart=/usr/bin/python3.11 /www/wwwroot/flow/app.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/wwwroot/flow/data

[Install]
WantedBy=multi-user.target
