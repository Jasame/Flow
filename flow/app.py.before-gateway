    day=time.strftime('%Y-%m-%d',time.gmtime());c.execute('BEGIN IMMEDIATE');c.execute('INSERT OR IGNORE INTO ai_usage VALUES(?,?,0)',(u['id'],day));n=c.execute('SELECT count FROM ai_usage WHERE user_id=? AND day=?',(u['id'],day)).fetchone()[0]
