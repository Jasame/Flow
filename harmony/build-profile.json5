{
  "app": {
    // Signing stays out of git: DevEco's automatic signing (or tools in README) adds a local signingConfig; never commit it.
    "signingConfigs": [],
    "products": [
      {
        // 「语流内测」 cn.flowlang.app.beta → https://flow.jasa.hk (the one DevEco runs by default)
        "name": "default",
        "bundleName": "cn.flowlang.app.beta",
        // the name on the home screen and in the system's questions: AppScope/resources_beta (语流内测), resources_prod (语流)
        "resource": { "directories": ["./AppScope/resources", "./AppScope/resources_beta"] },
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "arkOptions": {
            "buildProfileFields": {
              "FLOW_SITE": "https://flow.jasa.hk",
              "FLOW_BETA": "true",
              "FLOW_BUILD": "dev",
              "FLOW_BEIAN": ""
            }
          }
        }
      },
      {
        // 「语流」 cn.flowlang.app → https://flowlang.cn
        "name": "prod",
        "bundleName": "cn.flowlang.app",
        "resource": { "directories": ["./AppScope/resources", "./AppScope/resources_prod"] },
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "arkOptions": {
            "buildProfileFields": {
              "FLOW_SITE": "https://flowlang.cn",
              "FLOW_BETA": "false",
              "FLOW_BUILD": "dev",
              "FLOW_BEIAN": ""
            }
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        // 内测版 and 正式版 each with its own module target (entry/build-profile.json5: the name in src/beta, src/prod)
        { "name": "default", "applyToProducts": ["default"] },
        { "name": "prod", "applyToProducts": ["prod"] }
      ]
    }
  ]
}
