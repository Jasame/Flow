{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "语流",
  "mainBinaryName": "flow",
  "version": "0.1.1",
  "identifier": "cn.flowlang.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "site"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Education",
    "publisher": "语流 Flow",
    "copyright": "语流 Flow · flowlang.cn",
    "shortDescription": "语流 · 英语学习",
    "longDescription": "语流 Flow 的桌面版：听、读、单词和口语练习，系统媒体键、复习提醒通知。",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ],
        "section": "education"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "flowlang"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4MDhBNUVCNDc0MDk3RDkKUldUWmwwQkg2NlVJbUZab0tua01wMURDUzRtcUNpczhDckViNERxYUVHSFlIemxGR3RIcWlPSGoK",
      "endpoints": [
        "https://flowlang.cn/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
