{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site-beta",
  "description": "语流 内测版 (flow.jasa.hk) may call the window.FlowApp commands, and nothing else (the Beta build only; tauri.beta.conf.json).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://flow.jasa.hk",
      "https://flow.jasa.hk/*"
    ]
  },
  "permissions": [
    "allow-media-update",
    "allow-notify-permission",
    "allow-notify-ask",
    "allow-notify-due",
    "allow-notify-plan",
    "allow-notify-signed-out",
    "allow-notify-off",
    "allow-notify-hold",
    "allow-notify-pending",
    "allow-notify-account",
    "allow-smoke-report"
  ]
}
