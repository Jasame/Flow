{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site",
  "description": "语流 正式版 (flowlang.cn) may call the window.FlowApp commands, and nothing else; no other site ever loads in the window (links.rs).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://flowlang.cn",
      "https://flowlang.cn/*"
    ]
  },
  "permissions": [
    "allow-media-update",
    "allow-notify-permission",
    "allow-notify-ask",
    "allow-notify-due",
    "allow-notify-plan",
    "allow-notify-signed-out",
    "allow-notify-off",
    "allow-notify-hold",
    "allow-notify-pending",
    "allow-notify-account",
    "allow-smoke-report"
  ]
}
