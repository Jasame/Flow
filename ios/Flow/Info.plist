<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the site the app opens: Beta.xcconfig / Release.xcconfig -->
	<key>FlowSiteURL</key>
	<string>$(FLOW_SITE_URL)</string>
	<!-- the widgets' numbers (Common/TodayCard.swift), and the link a widget or a Control Center button opens the app
	     with: yuliu://open?path=%23/review (语流内测: yuliu-beta) -->
	<key>FlowAppGroup</key>
	<string>$(FLOW_APP_GROUP)</string>
	<key>FlowURLScheme</key>
	<string>$(FLOW_URL_SCHEME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(FLOW_BUNDLE_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(FLOW_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<!-- a whole text keeps playing with the screen locked; reminders follow the counts; 离线朗读包 at night -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- a few times a day: the next two weeks of review reminders follow the counts (Shell.refreshTask);
	     once a night on Wi-Fi while charging: today's recordings when 离线朗读包 is on (Packs.task) -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>cn.flowlang.app.refresh</string>
		<string>cn.flowlang.app.packs</string>
	</array>
	<!-- the site's own domains: service worker (offline, audio cache), the JS bridge and cookies only there -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>$(FLOW_SITE_HOST)</string>
		<string>$(FLOW_BOUND_EXTRA)</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- one window: the web view, the player and the bridge exist once per app (iPad: no second 语流 window) -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
